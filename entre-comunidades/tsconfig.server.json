{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
