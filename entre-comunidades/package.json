    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "maintenance": "node dist/server/maintenance.js"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "24.10.1"
  }
}
